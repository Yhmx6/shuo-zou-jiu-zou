# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# 协作产物与旧备份
# （本项目构建输出在 .next；build/ 里放的是每轮契约文档，必须纳入版本管理，
#   所以不再沿用 create-next-app 模板里的 /build 规则——它会把这些文档一起误伤）
/build/*.bak
/build/reviewer*/
/build/reports/
/build/baseline/
_next-build-bak/
.next.bak-*/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
/tsconfig.tsbuildinfo
next-env.d.ts

# amap api cache
.cache/

# legacy project backup
_legacy/

# ── 地点数据：白名单模式 ─────────────────────────────────────
# 仓库只带一份手工编写的示例数据（example），用来跑通完整流程、充当采集模板。
# 真实城市数据请用 `npm run fetch:seed <city>` 自行采集 —— 采集结果不进版本管理
# （地点数据来自高德开放平台，版权归原提供方，不宜二次分发）。
# 加新城市时，在白名单里补三行：<city>.json / <city>.manual.json / <city>.events.json
/data/cities/*
!/data/cities/index.json
!/data/cities/example.json
!/data/cities/example.manual.json
!/data/cities/example.events.json

# 归档文件（下划线前缀 = 非活动数据，见 scripts/check-city.ts 的约定）
/data/cities/_archived-*
