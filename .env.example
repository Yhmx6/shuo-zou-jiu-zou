# ── 高德（必需）────────────────────────────────────────────────
# 高德开放平台「Web 服务」类型的 Key —— 服务端用（POI 搜索 / 算路 / geocode）
# 不要填 Web端(JS API) 的 Key，两者不通用
AMAP_KEY=

# 高德「Web端(JS API)」Key 与安全密钥 —— 前端地图 SDK 用
# NEXT_PUBLIC_ 前缀会进前端包，这是 JS API 的必需设计，不是泄漏；
# 请在高德控制台配置「安全域名」（127.0.0.1 + 部署域名，localhost 不是合法域名）
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# ── 文案生成（可选）──────────────────────────────────────────────
# 不填也能跑：lib/llmText.ts 在缺 key 时返回 null，行程照常生成，只是每站没有一句话文案。
# 接口按 OpenAI 兼容协议调用 {LLM_BASE_URL}/chat/completions，不依赖任何 SDK。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 默认城市 ──────────────────────────────────────────────────
# 对应 data/cities/<ACTIVE_CITY>.json；页面 URL 的 ?city= 会覆盖它。
# 仓库自带的 example 是手工编写的示例数据（15 个点），用来跑通流程；
# 真实城市数据请用 `npm run fetch:seed <city>` 自己采集。
ACTIVE_CITY=example

# ── 后台访问控制（一般不用改）─────────────────────────────────────
# /admin 与 /api/admin 默认只允许本机访问。
# 需要临时用手机 / 局域网访问后台时设为 true —— 后台没有任何鉴权，
# 公开部署前必须换成真正的登录（会话 + 密码哈希），不要长期开着。
ADMIN_ALLOW_REMOTE=
